<.meta />

<link rel="canonical" href={"//#{@host}#{unless assigns[:root], do: assigns[:canonical] || canonical(@path)}"} />
<link rel="license" href="//creativecommons.org/publicdomain/zero/1.0/" />
<link rel="stylesheet" href={Enum.join([
  if @host not in config!(:primary) do "//cdn.geheimesite.nl" end,
  Map.get(assigns, :stylesheet, "/main.css")])} type="text/css" />
<script src="//api.geheimesite.nl/le-global.js"></script>

<title>{@title}</title>

<link rel="shortcut icon" href="/favicon.ico" />