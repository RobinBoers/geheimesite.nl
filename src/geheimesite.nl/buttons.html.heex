        </a>
        <a href="//theoldnet.com">
          <.badge src="/images/buttons/theoldnet.gif" alt="TheOldNet" />
        </a>
        <a href="//neocities.org">
          <.badge src="/images/buttons/neocities.gif" alt="NeoCities" />
        </a>
        <a href="//indieweb.org">
          <.badge src="/images/buttons/indieweb.png" alt="IndieWeb" />
        </a>
        <a href="//webmention.net">
          <.badge src="/images/buttons/webmention.png" alt="Webmention" />
        </a>
        <a href="//microformats.org">
          <.badge src="/images/buttons/microformats.png" alt="Microformats3" />
        </a>
        <a href="/colophon">
          <.badge src="/images/buttons/webmentions.gif" alt="Webmentions supported" />
        </a>
        <a href="//archlinux.org">
          <.badge src="/images/buttons/linux.gif" alt="Made on GNU/Linux" />
        </a>
        <a href="/rss">
          <.badge src="/images/buttons/rss.gif" alt="RSS feed" />
        </a>
        <a href="//freebsd.org">
          <.badge src="/images/buttons/powered-by-freebsd.gif" alt="Powered by FreeBSD" />
        </a>
        <.badge src="/images/buttons/humanmade.gif" alt="Human-made" />
        <.badge src="/images/buttons/bad-hair-days.gif" alt="There are no bad hair days on the internet" />
        <.badge src="/images/buttons/16bit.gif" alt="Best viewed 1024x768 16bit color" />
        <.badge src="/images/buttons/piracy.gif" alt="Piracy Now!" />
        <a href="//lynx.browser.org">
          <.badge src="/images/buttons/lynx-now.gif" alt="Lynx Now!" />
        </a>
        <.badge src="/images/buttons/dumbass.gif" alt="dumbass webmaster ahead!" />
        <.badge src="/images/buttons/design.png" alt="graphic design is my passion" />
        <.badge src="/images/buttons/queer.png" alt="you're telling me a queer coded this" />
        <a href="//satyrs.eu">
          <.badge src="/images/buttons/sites/satyrs.png" alt="Satyrs Forest" />
        </a>
        <a href="//devastatia.com">
          <.badge src="/images/buttons/sites/devastatia.png" alt="Devastatia" />
        </a>
        <a href="//foreverliketh.is">
          <.badge src="/images/buttons/sites/foreverlikethis.png" alt="Foreverliketh.is" />
        </a>
        <a href="//maya.land">
          <.badge src="/images/buttons/sites/mayaland.png" alt="Maya Land" />
        </a>
        <a href="//degenerates.neocities.org">
          <.badge src="/images/buttons/sites/degenerate.png" alt="Degenerates" />
        </a>
        <a href="//suboptimalism.neocities.org/writings/yesterweb">
          <.badge src="/images/buttons/yesterweb.png" alt="YesterWeb" />
        </a>
        <a href="//sadgrl.online">
          <.badge src="/images/buttons/sites/sadgrl.gif" alt="sadgrl" />
        </a>
        <a href="//wiby.me">
          <.badge src="/images/buttons/wiby.gif" alt="Wiby" />
        </a>
        <a href="//old.reddit.com">
          <.badge src="/images/buttons/reddit.gif" alt="Reddit" />
        </a>
        <.badge src="/images/buttons/fuckai.png" alt="written by human, NOT AI" />
        <a href="//indieseek.xyz">
          <.badge src="/images/buttons/indieseek.png" alt="IndieSeek" />
        </a>
      </p>

      <p>
        <.badge alt="" src="/images/buttons/small/cc0.png" />
        <.badge alt="" src="/images/buttons/small/indieweb.webp" />
        <.badge alt="" src="/images/buttons/small/microformats.webp" />
        <.badge alt="" src="/images/buttons/small/webmention.png" />
        <.badge alt="" src="/images/buttons/small/anybrowser.png" />
        <.badge alt="" src="/images/buttons/small/valid-html5.png" />
        <.badge alt="" src="/images/buttons/small/valid-rss2.png" />
        <.badge alt="" src="/images/buttons/small/valid-css.png" />
      </p>

      <p>
        <a style="display: block; float: right" href="//gossipsweb.net">
          <img
            src="/images/buttons/madewithhands.jpg"
            alt="This website was made with hands."
            height="45"
            width="330" />
        </a>
      </p>

      <p>
        Here's my button: <br />
        <.badge src="/images/button.png" alt="Axcelott :sparkles:" />
      </p>
    </main>

    <footer>
      <.footer />
    </footer>
  </body>
</html>