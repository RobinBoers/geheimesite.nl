        </a>
        <a href="//gnu.org/licenses/agpl-3.0.en.html">
          <.badge src="/images/buttons/agpl.gif" alt="AGPLv3" />
        </a>
        <a href="//gnu.org/licenses/gpl-3.0.en.html">
          <.badge src="/images/buttons/gpl.gif" alt="GPLv3" />
        </a>
        <a href="//yesterweb.org/no-to-web3/">
