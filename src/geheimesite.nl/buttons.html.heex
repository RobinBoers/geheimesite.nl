<!DOCTYPE html>
<html lang="en">
  <head>
    <.head title="Friends :love:" {assigns} />

    <style>
      p { max-width: 754px }
      a { text-decoration: none !important }
      img { image-rendering: pixelated }
    </style>
  </head>
  <body>
    <.nav {assigns} />

    <main>
      <h1>Friends :love:</h1>

      <p>
        Beautifully chaotic collection of oldschool 88x31 buttons--
        the true friendship bracelets of the Web.
      </p>

      <p>
        <a href="//validator.w3.org/nu/?doc=https%3A%2F%2Fgeheimesite.nl">
          <.badge src="/images/buttons/valid-html.gif" alt="Valid HTML" />
        </a>
        <a href="//jigsaw.w3.org/css-validator/check/referer">
          <.badge src="/images/buttons/valid-css.gif" alt="Valid CSS" />
        </a>
        <.badge src="/images/buttons/invalidator.gif" alt="Shit HTML" />
        <a
          href="//validator.w3.org/feed/check.cgi?url=https%3A%2F%2Fgeheimesite.nl%2Findex.xml">
          <.badge src="/images/buttons/valid-rss.png" alt="Valid RSS" />
        </a>
        <a
          href="//validator.w3.org/feed/check.cgi?url=https%3A%2F%2Fgeheimesite.nl%2Fatom.xml">
          <.badge src="/images/buttons/valid-atom.png" alt="Valid Atom" />
        </a>
        <a
          href="//www.jwz.org/blog/2016/10/they-live-and-the-secret-history-of-the-mozilla-logo/">
          <.badge src="/images/buttons/choose-mozilla.gif" alt="Choose Mozilla" />
        </a>
        <a href="//duckduckgo.com">
          <.badge src="/images/buttons/duckduckgo.gif" alt="DuckDuckGo" />
        </a>
        <.badge src="/images/buttons/internet-exploder.gif" alt="Microsoft Internet Exploder" />
        <a href="//mozilla.org">
          <.badge src="/images/buttons/mozilla-old.gif" alt="Mozilla" />
        </a>
        <.badge src="/images/buttons/best-viewed-with-eyes.gif" alt="Best viewed with Eyes" />
        <a href="//yewtu.be/watch?v=dQw4w9WgXcQ">
          <.badge src="/images/buttons/clickhere.gif" alt="Click here" />
        </a>
        <a href="//firefox.com">
          <.badge src="/images/buttons/firefox.gif" alt="Firefox" />
        </a>
        <a href="//firefox.com">
          <.badge src="/images/buttons/firefox2.gif" alt="Firefox" />
        </a>
        <a href="//pages.github.com">
