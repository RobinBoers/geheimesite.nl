# Services

rss.dupunkto.org {
	import logging
	import txts
	import security
	import landing
  reverse_proxy miniflux:8080
}

inv.dupunkto.org {
	import logging
	import txts
	import security
	import landing
  # reverse_proxy invidious:3000
}

mpv.dupunkto.org {
	import logging
	import txts
	import security
	import landing
  reverse_proxy host.docker.internal:8096
}

vik.dupunkto.org {
	import logging
	import txts
	import security
	
	handle_path /api/* {
		redir https://api.dupunkto.org{uri}
	}

	reverse_proxy vik:4000
}

fog.scatterbrain.nl {
	import logging
	import txts
	import security
	
	handle_path /api/* {
		redir https://api.geheimesite.nl{uri}
	}

	reverse_proxy fog:4000
}

