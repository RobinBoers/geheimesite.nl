www.ilysm.fr {
	import logging
	import security

	redir https://{labels.1}.{labels.0}{uri}
}

ilysm.fr {
	import logging
	import errors
	import txts
	import autodiscover
	import security

	redir / https://geheimesite.nl temporary

	respond /ip "{http.request.remote.host}" 200
	respond /ua "{http.request.header.User-Agent}" 200

	file_server /uptime {
		root /var/log
	}

	reverse_proxy /geo https://eu-api.ipdata.co {
    rewrite /{http.request.remote.host}?api-key={$IPDATA_API_KEY}
    header_up Host eu-api.ipdata.co
	}
}

