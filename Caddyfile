api.dupunkto.org {
	route {
		import logging
		import txts
		import favicon
		import security

		import landing

		handle {
			rewrite * /api{path}
			reverse_proxy vik:4000
		}
	}
}

api.geheimesite.nl {
	route {
		import logging
		import txts
		import favicon
		import security
		import caching

		@files path /*.js /resources/*

		import landing

		handle @files {
			root * /var/www/html/api.geheimesite.nl
			try_files {path} {path}.json {path}.opml
			file_server
		}

		handle {
			rewrite * /api{path}
			reverse_proxy fog:4000
		}
	}
}

