api.dupunkto.org {
	import logging
	import txts
	import security
	
	route {
		import landing		

		handle {
			rewrite * /api{path}
			reverse_proxy vik:4000
		}
	}
}

api.geheimesite.nl {
	import logging
	import txts
  import security

	@static path /*.js /resources/*

	route {
		import landing

		handle @static {
			root * /var/www/html/api.geheimesite.nl
			try_files {path} {path}.json {path}.opml
			file_server
		}

		handle {
			rewrite * /api{path}
			reverse_proxy fog:4000
		}
	}
}

