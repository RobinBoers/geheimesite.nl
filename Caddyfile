#			roll_disabled
#		}
#	}
}

(favicon) {
	@favicon_dupunkto {
		path /favicon.ico
		host dupunkto.org *.dupunkto.org
	}
	file_server @favicon_dupunkto {
		root /var/www/html/dupunkto.org
	}

	@favicon_geheimesite {
		path /favicon.ico
		host geheimesite.nl *.geheimesite.nl
	}
	file_server @favicon_geheimesite {
		root /var/www/html/geheimesite.nl
	}
}

(txts) {
	redir /.well-known/robots.txt /robots.txt temporary
	redir /.well-known/security.txt /security.txt temporary

	@robots {
		path /robots.txt
	}

	file_server @robots {
		root /var/www/html/geheimesite.nl
	}

	@security {
		path /security.txt
	}

	file_server @security {
		root /var/www/html/geheimesite.nl
	}
}

(autodiscover) {
	@config {
		path /.well-known/autoconfig/mail/config-v1.1.xml
	}

	file_server @config {
		root /var/www/html/geheimesite.nl
	}
}

(landing) {
	@landing {
		path /
		expression `{query} == ""`
	}

	handle @landing {
		root * /var/www/html
		rewrite {host}/index.html
		file_server
	}
}

(nym) {
  rewrite * /proxy?{query}
  reverse_proxy nym:80 {
    header_up X-Forwarded-Host {host}
    header_up X-Forwarded-Proto {scheme}
    header_up X-Forwarded-To {args[0]}
    header_up X-Forwarded-Path {http.request.orig_uri.path}
  }
}

(security) {
	header {
		-Server
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "deny"
		Cross-Origin-Opener-Policy "same-origin"

		# HSTS: Enable automatic HTTPS redirects for a year
		Strict-Transport-Security "max-age=31536000"

		# Allow other sites to get content
		# See https://ncase.me/nutshell/#CORSForWebDevs
		Access-Control-Allow-Origin "*"
	}
}

(caching) {
	encode zstd gzip

	@static {
		file
		path *.jpg *.jpeg *.png *.gif *.webp *.ico *.svg *.woff *.woff2 *.onnx
	}
	handle @static {
		header Cache-Control "max-age=31536000, immutable"
	}

	@assets {
		file
		path *.js *.css
	}
	handle @assets {
		header Cache-Control "max-age=604800, stale-while-revalidate=86400"
	}

	@content {
		file
		path *.html *.pdf *.txt
	}
	handle @content {
		header Cache-Control "max-age=129600"
	}
}

(static) {
	@strip_index {
		path_regexp index ^(.*)/index\.html$
	}
	redir @strip_index {scheme}://{host}{re.index.1}/ 301

	@strip_html {
		path_regexp html ^(.*)\.html$
	}
	redir @strip_html {scheme}://{host}{re.html.1} 301

	@strip_php {
		path_regexp php ^(.*)\.php$
	}
	redir @strip_php {scheme}://{host}{re.php.1} 301

	root * /var/www/html

	@enter_dir_html {
		file {host}{path}/index.html
		not path */
	}
	redir @enter_dir_html {uri}/ 301

	@enter_dir_php {
		file {host}{path}/index.php
		not path */
	}
	redir @enter_dir_php {uri}/ 301

	try_files {host}{path} {host}{path}/index.html {host}{path}/index.php {host}{path}.html {host}{path}.php
	file_server
}

