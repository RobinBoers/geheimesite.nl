type: static
host: nov.dupunk.to
services:
- name: router
  src: Caddyfile
  target: Caddyfile
  restart:
  - router
- name: bootstrap
  src: bootstrap.sh
  target: /volume1/docker/bootstrap.sh
- name: priv
  src: priv/*.tpl
  target: /volume1/www
- name: geheimesite.nl
  src: dist/geheimesite.nl
  exclude:
  - r
  - js0.23
- name: cdn.geheimesite.nl
  src: dist/cdn.geheimesite.nl
  exclude:
  - images
  - videos
  - recordings
  - fonts
  - icons
  - ghme.css
- name: api.geheimesite.nl
  src: dist/api.geheimesite.nl
  exclude:
  - resources
- name: november.geheimesite.nl
  src: dist/november.geheimesite.nl
- name: classic.geheimesite.nl
  src: dist/classic.geheimesite.nl
  exclude:
  - v
  - robots.txt
- name: nm.geheimesite.nl
  src: dist/nm.geheimesite.nl
